# ── Clarere — Ortam Değişkenleri ─────────────────────────────────

# Model (DeepSeek API — zorunlu)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# LLM dayanıklılık (P0-5)
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_RETRIES=3
# Bir araştırmanın toplam bütçesi (saniye) — aşılırsa kalan personalar atlanır
RESEARCH_DEADLINE_SECONDS=300

# Eşzamanlı istek kapasitesi (senkron endpoint threadpool boyutu)
THREADPOOL_SIZE=64

# DeepSeek token fiyatları (USD / 1M token) — P0-6 maliyet muhasebesi
# Resmi fiyat sayfasından doğrulanıp güncellenmelidir.
DEEPSEEK_PRICE_FLASH_INPUT=0
DEEPSEEK_PRICE_FLASH_OUTPUT=0
DEEPSEEK_PRICE_FLASH_CACHE_HIT=0
DEEPSEEK_PRICE_PRO_INPUT=0
DEEPSEEK_PRICE_PRO_OUTPUT=0
DEEPSEEK_PRICE_PRO_CACHE_HIT=0

# Ortam
APP_ENV=development

# PostgreSQL (docker-compose için POSTGRES_PASSWORD zorunlu)
POSTGRES_USER=clarere_user
POSTGRES_PASSWORD=guclu-bir-sifre
POSTGRES_DB=clarere_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# App DB rolü — RLS'ye tabi, superuser OLMAYAN (tenant izolasyonu için)
APP_DB_USER=clarere_app
APP_DB_PASSWORD=clarere_app_password

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
VALKEY_URL=redis://localhost:6379/0

# Güvenlik — production'da zorunlu (APP_ENV=production iken ALLOWED_ORIGINS boşsa backend açılmaz)
ADMIN_SECRET_KEY=your-admin-secret-key-here
JWT_SECRET=your-jwt-signing-secret-here
ALLOWED_ORIGINS=https://clarere.com

# ── Paddle Billing (P0-2) ──
# Paddle hesabından alınır. Sandbox anahtarları _sdbx içerir.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# Paddle Dashboard'da oluşturulan fiyat ID'leri (price → plan eşlemesi)
PADDLE_PRICE_FLEX=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=

# Frontend — Paddle.js (yayınlanması güvenli)
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
