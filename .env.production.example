# ── Clarere Production Ortam Şablonu ──
# Sunucuda /opt/clarere/.env olarak kopyala ve gerçek değerleri gir.
#   cp .env.production.example .env && chmod 600 .env
# ASLA commit etme.

# ── Ortam ──
APP_ENV=production
ALLOWED_ORIGINS=https://clarere.com,https://www.clarere.com

# ── Güvenlik (production'da ZORUNLU) ──
# Üret: openssl rand -base64 48
JWT_SECRET=
ADMIN_SECRET_KEY=

# ── DeepSeek ──
DEEPSEEK_API_KEY=
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_RETRIES=3
RESEARCH_DEADLINE_SECONDS=300
THREADPOOL_SIZE=32

# ── PostgreSQL (Neon — POOLED host kullan) ──
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=clarere_db
POSTGRES_USER=
POSTGRES_PASSWORD=
# Neon'da ayrı rol oluşturulamaz → aynı rolü kullan
APP_DB_USER=
APP_DB_PASSWORD=
PG_POOL_MIN=1
PG_POOL_MAX=5

# ── Redis (Docker iç ağı) ──
REDIS_HOST=redis
REDIS_PORT=6379
VALKEY_URL=redis://redis:6379/0
CELERY_CONCURRENCY=1

# ── Paddle Billing ──
# Canlıya geçerken PADDLE_ENV=production + live anahtarlar/price ID'ler
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_FLEX=

# ── Token maliyet fiyatları (USD / 1M token) ──
DEEPSEEK_PRICE_FLASH_INPUT=0
DEEPSEEK_PRICE_FLASH_OUTPUT=0
DEEPSEEK_PRICE_FLASH_CACHE_HIT=0
DEEPSEEK_PRICE_PRO_INPUT=0
DEEPSEEK_PRICE_PRO_OUTPUT=0
DEEPSEEK_PRICE_PRO_CACHE_HIT=0

# ── Sentry (opsiyonel — boşsa devre dışı) ──
SENTRY_DSN=

# ── E-posta / Resend (opsiyonel — boşsa e-posta gönderilmez) ──
RESEND_API_KEY=
RESEND_FROM=Clarere <hiclarere@clarere.com>
CONTACT_NOTIFY_EMAIL=hiclarere@clarere.com
